-- Sharing metadata.  Read by tooling and the manager's detail pane, never by
-- the loader's merge, so an absent or malformed card can never break a load.
return {
  summary = "All 151 renewably obtainable in one save, without touching a vanilla slot.",
  author = "Wild",
  tags = { "content", "encounters", "completion", "data-only" },
  differences = {
    changed = {
      "Vanilla species' SHARE of encounters on a placed map shifts by the "
        .. "configured substitution rate; probability is conserved and "
        .. "something has to give",
      "Celadon Department Store 4F sells a LINK CABLE beside the evolution "
        .. "stones",
    },
    added = {
      "Renewable wild spawns for every species that had none: version "
        .. "exclusives, starters, gift mons, NPC-trade mons, the fossils and "
        .. "Snorlax",
      "LINK CABLE, a consumable that runs one trade evolution",
      "A caption under Gen1Dex's AREA map for every spawn this mod places: "
        .. "the map, the level band, the tier and the HM the map needs, "
        .. "handed to that screen through its provider hook",
      "A Mew unlock behind the four Pokemon Mansion journals, on by default "
        .. "and switchable off",
    },
    known = {
      "The encounter RATE per map is never touched, so a species placed on a "
        .. "map with a low rate is genuinely slow to find; the RARITY % "
        .. "option is there for players who would rather it were not",
      "Red and Blue give only Routes 19, 20 and 21 a live surf rate, so "
        .. "water placement is nearly unavailable there and almost "
        .. "everything lands in grass or on the Super Rod instead",
      "The roll layer deliberately ignores any `buckets` list on an "
        .. "encounter record, so another encounter mod's 11th-and-beyond "
        .. "slots stay unreachable on maps Gen151 touches -- which is what "
        .. "they already were without a bucket list of their own",
      "The AREA screen the captions go on belongs to Gen1Dex 1.3.0 or newer "
        .. "-- the mod that draws the dex row the press lands on.  Without "
        .. "it AREA HINTS has nothing to write on, and nothing else about "
        .. "this mod changes.  MEW's sealed screen reads as Gen1Dex's "
        .. "no-record line from 1.4.0, and as a blank map before that",
      "engine_internals is still declared, for one call: the LINK CABLE's "
        .. "own sound effect reaches src.core.Sound, which the mod surface "
        .. "has no facade for",
    },
  },
  credits = {
    { who = "Wowabox (Darklinkduck)",
      for_ = "All Pokemon Catchable 151, which got to completing the Kanto "
        .. "dex in one save without trading first.  That mod set the goal "
        .. "this one is a second take on; none of its code is used here, but "
        .. "the idea is theirs" },
    { who = "pret/pokered and pret/pokeyellow",
      for_ = "the disassembly every placement in this mod is derived from" },
    { who = "Pokemon Gen 1 Recompilation Project",
      for_ = "the encounter, merge and hook seams this mod is built on" },
    { who = "Gen1Dex",
      for_ = "the AREA screen this mod's captions are written onto, and the "
        .. "provider hook they register through" },
    { who = "Nintendo / Creatures / GAME FREAK",
      for_ = "Pokemon Red, Blue, Yellow and Let's Go, whose own Kanto "
        .. "placements are used wherever they answered the question first.  "
        .. "Unofficial fan mod, no affiliation, no endorsement" },
  },
  compat = { engine = ">=1.0.0 <2.0.0", modApi = 2 },
}
